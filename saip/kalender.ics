---
layout: null
permalink: /saip/kalender.ics
---
{%- assign days = site.data.saip_events | group_by_exp: "e", "e.start | date: '%Y-%m-%d'" | sort: "name" -%}
{%- assign events = "" | split: "" -%}
{%- for day in days -%}{%- assign items = day.items | sort: "time" -%}{%- assign events = events | concat: items -%}{%- endfor -%}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//SAIP//Kalender//SV
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:SAIP – tech och AI i Jämtlands län
REFRESH-INTERVAL;VALUE=DURATION:PT12H
X-PUBLISHED-TTL:PT12H
{%- for e in events %}
{%- assign last_day = e.end | default: e.start %}
{%- capture where %}{{ e.place }}{% if e.venue %}, {{ e.venue }}{% endif %}{% endcapture %}
{%- capture about %}{{ e.time }}. Arrangör: {{ e.organiser }}.{% if e.cost %} {{ e.cost }}.{% endif %}{% if e.deadline %} Anmälan senast {{ e.deadline | date: "%Y-%m-%d" }}.{% endif %}{% if e.note %} {{ e.note }}{% endif %} {{ e.url }}{% endcapture %}
BEGIN:VEVENT
UID:{{ e.start | date: "%Y%m%d" }}-{{ e.title | slugify: "latin" }}@saip
DTSTAMP:{{ site.time | date: "%Y%m%dT%H%M%SZ" }}
DTSTART;VALUE=DATE:{{ e.start | date: "%Y%m%d" }}
DTEND;VALUE=DATE:{{ last_day | date: "%s" | plus: 129600 | date: "%Y%m%d" }}
{%- capture what %}{% if e.series %}{{ e.series }}: {% endif %}{{ e.title }}{% endcapture %}
SUMMARY:{{ what | replace: "\", "\\" | replace: ",", "\," | replace: ";", "\;" }}
LOCATION:{{ where | replace: "\", "\\" | replace: ",", "\," | replace: ";", "\;" }}
DESCRIPTION:{{ about | replace: "\", "\\" | replace: ",", "\," | replace: ";", "\;" }}
{% if e.url %}URL:{{ e.url }}
{% endif %}END:VEVENT
{%- endfor %}
END:VCALENDAR
